// ============================================================
// CURAGE VANDAELE – Règles de sécurité Firestore
// ============================================================
// À coller dans : Firebase Console > Firestore > Rules
// Puis cliquer "Publier"
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tarifs partagés avec l'outil d'estimation
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /demandes/{demandeId} {

      // Le formulaire public peut créer une demande (INSERT)
      allow create: if true;

      // Seuls les utilisateurs connectés (admin) peuvent lire et modifier
      allow read, update: if request.auth != null;

      // Seul l'admin connecté peut supprimer
      allow delete: if request.auth != null;
    }

    match /abandons/{sessionId} {

      // L'outil public peut créer et mettre à jour sa propre session
      allow create: if true;
      allow update: if true;

      // Seul l'admin peut lire et supprimer
      allow read, delete: if request.auth != null;
    }
  }
}

// ============================================================
// ÉTAPES DE CONFIGURATION (à faire une seule fois)
// ============================================================
//
// 1. Créer un projet Firebase sur https://console.firebase.google.com
//
// 2. Activer Firestore :
//    Firestore Database > Créer une base de données > Mode Production
//
// 3. Coller ces règles dans :
//    Firestore Database > Règles > (coller ci-dessus) > Publier
//
// 4. Activer l'authentification par email :
//    Authentication > Sign-in method > Email/mot de passe > Activer
//
// 5. Créer votre compte admin :
//    Authentication > Users > Ajouter un utilisateur
//    → Entrez votre email + mot de passe
//
// 6. Récupérer la config Firebase :
//    Paramètres du projet (⚙️) > Vos applications > Ajouter une application Web
//    → Copier l'objet firebaseConfig
//    → Coller dans js/admin.js ET js/estimation.js
//       (constante FIREBASE_CONFIG, remplacer les valeurs VOTRE_*)
